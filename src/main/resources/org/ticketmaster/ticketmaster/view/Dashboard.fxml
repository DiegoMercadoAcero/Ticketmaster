<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ticketmaster.ticketmaster.view.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
            <Label text="TicketMaster Demo" textFill="white">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="15.0">
                <Label fx:id="lblUsuario" styleClass="label-usuario" text="Usuario" />
                <Button onAction="#handleLogout" styleClass="boton-logout" text="Cerrar Sesión" />
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <Label styleClass="titulo" text="MENÚ PRINCIPAL DEL SISTEMA" style="-fx-background-color: #2b5b84; -fx-text-fill: white; -fx-padding: 10px;"/>

            <GridPane alignment="CENTER" hgap="20" vgap="20">
                <Button text="🎭 TEATRO" onAction="#handleIrTeatro" prefWidth="200" prefHeight="60" style="-fx-background-color: #c94c4c; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                <Button text="🎬 CINE" onAction="#handleIrCine" prefWidth="200" prefHeight="60" style="-fx-background-color: #7fba5e; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Button text="🏛️ MUSEO" onAction="#handleIrMuseo" prefWidth="200" prefHeight="60" style="-fx-background-color: #3b71a8; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <Button text="👤 MI CUENTA" onAction="#handleIrCuenta" prefWidth="200" prefHeight="60" style="-fx-background-color: #e5973e; -fx-text-fill: white; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>