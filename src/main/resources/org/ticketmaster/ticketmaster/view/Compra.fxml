<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ticketmaster.ticketmaster.view.CompraController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
            <Label text="TicketMaster Demo" textFill="white">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="15.0">
                <Label fx:id="lblUsuario" styleClass="label-usuario" text="Usuario" />
                <Button onAction="#handleLogout" styleClass="boton-logout" text="Cerrar Sesión" />
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25.0">
            <padding><Insets bottom="40.0" left="60.0" right="60.0" top="40.0" /></padding>

            <Label text="🛒 Detalles de tu Compra" styleClass="titulo" />

            <GridPane hgap="15" vgap="20" alignment="CENTER" style="-fx-background-color: #f4f4f4; -fx-padding: 30px; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-background-radius: 5px;">
                <Label text="Evento:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblNombre" style="-fx-font-weight: bold; -fx-text-fill: #2b5b84; -fx-font-size: 16px;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Precio Unitario:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblPrecio" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Horario:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbHorario" prefWidth="250" promptText="Elige tu horario" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Cantidad:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Spinner fx:id="spnCantidad" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Método de Pago:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cmbPago" prefWidth="250" promptText="Selecciona pago" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Tu WhatsApp:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="txtTelefono" promptText="+52XXXXXXXXXX" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <HBox spacing="20.0" alignment="CENTER">
                <Button text="Cancelar" onAction="#handleCancelar" styleClass="boton-secundario" prefWidth="120" prefHeight="40" />
                <Button text="CONFIRMAR PAGO" onAction="#handlePagar" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="180" prefHeight="40"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>