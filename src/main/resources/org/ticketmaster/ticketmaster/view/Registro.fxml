<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@../estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ticketmaster.ticketmaster.view.RegistroController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label styleClass="titulo" text="Crear Cuenta" />

    <VBox spacing="10">
        <TextField fx:id="txtNombre" promptText="Nombre(s)" />
        <HBox spacing="10">
            <TextField fx:id="txtPaterno" promptText="Apellido Paterno" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtMaterno" promptText="Apellido Materno" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <VBox spacing="10">
        <TextField fx:id="txtUsername" promptText="Nombre de Usuario (ej. juanperez99)" />
        <TextField fx:id="txtCorreo" promptText="Correo Electrónico" />
    </VBox>

    <VBox spacing="10">
        <PasswordField fx:id="txtPassword" promptText="Contraseña" />
        <PasswordField fx:id="txtConfirmPassword" promptText="Confirmar contraseña" />
    </VBox>

    <HBox alignment="CENTER" spacing="15.0">
        <Button onAction="#handleVolver" styleClass="boton-secundario" text="Cancelar"/>
        <Button onAction="#handleRegistrar" styleClass="boton-principal" text="Registrarme" />
    </HBox>

    <Label fx:id="lblMensaje" styleClass="label-error"/>
</VBox>