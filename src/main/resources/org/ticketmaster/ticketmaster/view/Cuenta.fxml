<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ticketmaster.ticketmaster.view.CuentaController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
            <Label text="TicketMaster Demo" textFill="white"><font><Font name="System Bold" size="18.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="15.0">
                <Label fx:id="lblUsuario" styleClass="label-usuario" text="Usuario" />
                <Button onAction="#handleLogout" styleClass="boton-logout" text="Cerrar Sesión" />
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
            <Label text="👤 Mi Cuenta" styleClass="titulo" />

            <HBox spacing="15.0" alignment="CENTER">
                <Button text="Mi Perfil" onAction="#handlePerfil" styleClass="boton-secundario" />
                <Button text="Mis Boletos" onAction="#handleBoletos" styleClass="boton-secundario" />
                <Button text="Métodos de Pago" onAction="#handlePagos" styleClass="boton-secundario" />
            </HBox>

            <ScrollPane fitToWidth="true" prefHeight="250.0" prefWidth="500.0" styleClass="scroll-pane">
                <content>
                    <VBox fx:id="vboxDetalles" spacing="15.0">
                        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                    </VBox>
                </content>
            </ScrollPane>

            <HBox spacing="20.0" alignment="CENTER">
                <Button text="Volver al Menú Principal" onAction="#handleVolver" styleClass="boton-principal" />
            </HBox>
        </VBox>
    </center>
</BorderPane>